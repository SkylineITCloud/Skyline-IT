# ─── SKYLINE IT — Environment Configuration ───

# Server port (default: 3000)
PORT=3000

# Node environment (development / production)
NODE_ENV=development

# CORS origin allowed to access the API
CORS_ORIGIN=https://www.skylineit.site

# Hidden admin API key — used for /api/*/admin/* endpoints via X-Api-Key header
# Generate: node -e "console.log('sk_' + require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=sk_your_admin_api_key_here

# JWT Secret for StudySync
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_64_char_hex_secret_here

# JWT expiration
JWT_EXPIRES_IN=7d

# License metadata (displayed by /api/holding/health)
LICENSE_HOLDER=Skyline IT (S'nqobile Langa Hlatshwayo)
LICENSE_TYPE=MIT
